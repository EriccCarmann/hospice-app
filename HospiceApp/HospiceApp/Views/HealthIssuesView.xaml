<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:HospiceApp.ViewModels"
             xmlns:controls="http://zoft.MauiExtensions/Controls"
             xmlns:models="clr-namespace:HospiceApp.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodel:HealthIssuesViewModel"
             x:Class="HospiceApp.Views.HealthIssuesView"
             IsVisible="{Binding IsHealthIssuesVisible, FallbackValue=False}"
             x:Name="HealthIssues">
     <VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" Padding="10">
                <controls:AutoCompleteEntry 
                    Grid.Column="0"
                    Placeholder="Search"
                    Text="{Binding Name, Mode=TwoWay}" 
                    ItemsSource="{Binding FilteredList}"
                    TextMemberPath="Name"
                    DisplayMemberPath="Name"
                    TextChangedCommand="{Binding TextChangedCommand}"
                    CursorPosition="{Binding CursorPosition, Mode=TwoWay}"
                    SelectedSuggestion="{Binding SelectedItem, Mode=TwoWay}"
                    ClearButtonVisibility="Never"
                    HeightRequest="50"/>
                <Button Grid.Column="1"
                        Text="Search"
                        Command="{Binding SearchCommand}" />
            </Grid>
         <CollectionView x:Name="DiseasesCollectionView"
                         ItemsSource="{Binding Diseases}"
                         EmptyView="No diseases to display."
                         SelectionMode="None">
             <CollectionView.ItemTemplate>
                 <DataTemplate>
                     <Grid Padding="10" ColumnDefinitions="Auto,*,Auto">
                         <CheckBox>
                             <CheckBox.Behaviors>
                                 <toolkit:EventToCommandBehavior
                                     EventName="CheckedChanged"
                                     Command="{Binding Source={x:Reference HealthIssues}, Path=BindingContext.CheckBoxCheckedCommand}"
                                     CommandParameter="{Binding .}" />
                             </CheckBox.Behaviors>
                         </CheckBox>
                         <Label Grid.Column="1"
                                Text="{Binding Name}"
                                FontAttributes="Bold"
                                FontSize="18"
                                VerticalOptions="Center" />

                         <Label Grid.Column="2"
                                Text="{Binding ICDCode}"
                                FontSize="14"
                                VerticalOptions="Center"
                                TextColor="Gray" />
                     </Grid>
                 </DataTemplate>
             </CollectionView.ItemTemplate>
         </CollectionView>
        </VerticalStackLayout>
</ContentView>