<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HospiceApp.Views.SymptomBurdenView"
             IsVisible="{Binding IsSymptomBurdenVisible}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Pain Level" 
                   FontAttributes="Bold" />
            <Slider Minimum="0" 
                    Maximum="10" 
                    Value="{Binding PainLevel, 
                    Mode=TwoWay}" />
            <Label Text="{Binding PainLevel, StringFormat='Pain Level: {0:F0}'}" />

            <Label Text="Dyspnea (Shortness of Breath)" 
                   FontAttributes="Bold" />
            <Slider Minimum="0" 
                    Maximum="10" 
                    Value="{Binding DyspneaLevel, Mode=TwoWay}" />
            <Label Text="{Binding DyspneaLevel, StringFormat='Dyspnea Level: {0:F0}'}" />

            <Label Text="Nausea" 
                   FontAttributes="Bold" />
            <Slider Minimum="0" 
                    Maximum="10" 
                    Value="{Binding NauseaLevel, Mode=TwoWay}" />
            <Label Text="{Binding NauseaLevel, StringFormat='Nausea Level: {0:F0}'}" />

            <Label Text="Fatigue" 
                   FontAttributes="Bold" />
            <Slider Minimum="0" 
                    Maximum="10" 
                    Value="{Binding FatigueLevel, Mode=TwoWay}" />
            <Label Text="{Binding FatigueLevel, StringFormat='Fatigue Level: {0:F0}'}" />

            <Label Text="Anxiety" 
                   FontAttributes="Bold" />
            <Slider Minimum="0" 
                    Maximum="10" 
                    Value="{Binding AnxietyLevel, Mode=TwoWay}" />
            <Label Text="{Binding AnxietyLevel, StringFormat='Anxiety Level: {0:F0}'}" />

            <Label Text="Confusion" 
                   FontAttributes="Bold" />
            <Slider Minimum="0" 
                    Maximum="10" 
                    Value="{Binding ConfusionLevel, Mode=TwoWay}" />
            <Label Text="{Binding ConfusionLevel, StringFormat='Confusion Level: {0:F0}'}" />

            <Label Text="Needs Symptom Management Support?" 
                   FontAttributes="Bold" />
            <Switch IsToggled="{Binding NeedsSymptomSupport, Mode=TwoWay}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>