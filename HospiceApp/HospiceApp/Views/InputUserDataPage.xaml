<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:HospiceApp.ViewModels"
             xmlns:views="clr-namespace:HospiceApp.Views"
             x:DataType="viewmodel:InputUserDataViewModel"
             x:Class="HospiceApp.Views.InputUserDataPage">
    <ContentPage.Content>
        <VerticalStackLayout>
            <Grid x:Name="MultiStepGrid" RowDefinitions="Auto,Auto,Auto">
                <views:PatientDemographicsView
                    Grid.Row="0"
                    BindingContext="{Binding PatientDemographicsContext}"/>
                <views:HealthIssuesView
                    Grid.Row="1"
                    BindingContext="{Binding HealthIssuesContext}"/>
            </Grid>
            <Grid ColumnDefinitions="*, *">
                <Button
                    Grid.Column="0"
                    Text="Previous"
                    IsVisible="{Binding PreviousViewCommandVisibility}"
                    Command="{Binding PreviousViewCommand}"
                />
                <Button
                    Grid.Column="1"
                    Text="Next"
                    Command="{Binding NextViewCommand}"
                />
            </Grid>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>